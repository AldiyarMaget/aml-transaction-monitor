# Compiled class and build outputs
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Environment files & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.jks
credentials.json
secrets.yml
secrets.properties

# Local Spring Boot configurations
*-local.properties
*-local.yml
*-local.yaml
application-local.yml
application-local.properties

# Logs and Crash Dumps (May contain memory or personal data)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*
replay_pid*

# IDE: VS Code
.vscode/
*.code-workspace

