            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountFrom\": \"KZ1234567890123456\",\n  \"accountTo\": \"KZ9876543210987654\",\n  \"amount\": 7500000.00,\n  \"currency\": \"KZT\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/transactions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "2.1 Check Status - Suspicious",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/transactions/{{suspiciousTxId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "transactions",
            "{{suspiciousTxId}}"
          ]
        }
